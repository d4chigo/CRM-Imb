# Configuración del servidor CRM Inmobiliario
# Copia este archivo como .env y modifica los valores según tu entorno

PORT=3001

# Configuración de base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=crm_imb

# Configuración de autenticación JWT
# IMPORTANTE: Cambiar estos secrets en producción por valores aleatorios seguros
JWT_SECRET=generar_secret_jwt_super_seguro_para_produccion
JWT_REFRESH_SECRET=generar_refresh_secret_super_seguro_para_produccion
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Configuración de cookies seguras
# IMPORTANTE: Cambiar este secret en producción
COOKIE_SECRET=generar_cookie_secret_super_seguro_para_produccion

# Entorno de desarrollo
NODE_ENV=development

# URL del frontend para CORS
FRONTEND_URL=http://localhost:3000
