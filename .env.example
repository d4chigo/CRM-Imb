#############################################
# CRM Inmobiliario - Variables de Entorno   #
# Copia este archivo a .env en la RAÍZ      #
# y reinicia frontend y backend             #
#############################################

# --- Servidor Backend ---
PORT=4000
NODE_ENV=development

# --- Base de Datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crm_imb

# --- JWT ---
JWT_SECRET=change_me_super_secret_jwt
JWT_REFRESH_SECRET=change_me_super_secret_jwt_refresh
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# --- Cookies ---
COOKIE_SECRET=change_me_cookie_secret

# --- Frontend URL (CORS) ---
FRONTEND_URL=http://localhost:3000

# --- Google Contacts Import ---
# Crear credenciales OAuth en Google Cloud (tipo Web) y poner URIs de redirect:
# http://localhost:4000/api/google/contacts/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/contacts/callback

# --- Frontend Runtime (prefijo NEXT_PUBLIC_ para exponer en bundle) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=CRM Inmobiliario

#############################################
# NOTAS:
# 1. Backend lee .env de la raíz; ya no usar server/.env.
# 2. El frontend también cargará de la raíz si copias manualmente variables
#    (Next sólo carga .env.local/.env* en /client, pero podemos documentar copiar).
# 3. Para separar entornos crea archivos .env.development, .env.production, etc.
#############################################